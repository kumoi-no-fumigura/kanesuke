 "poems": [
  {
   "seq": "1",
   "text": "あたらしき年の始の嬉しきはふるき人とちあへる也けり",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "むは玉のこよひはかりかあけ衣あけなは人をよそにこそみめ",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "故〓のみかさの山は遠けれと聲はむかしのうとからなくに",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "宿ちかくうつして植しかひもなく待とほにのみ匂ふ花哉",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "やと近く匂はさりせは梅花風のたよりに君をみましや",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "君かため我おるやとの梅花色にそ出る深き心は",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "色も香もともに匂へる梅花ちるうたかひのあるや何なり",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "梅花立よるはかり有しより人のとかむる香にそしみぬる",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "もとの香のあるたにあるを梅花いとゝ匂ひのそはりぬる哉",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "靑柳のまゆにこもれる糸なれは春のくるにそ色まさりける",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "君かゆくかた野はるかに聞しかと慕へはきぬる物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "櫻花匂ふを見つゝかへるにはしつ心なきものにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "立かへり花をそわれは恨こし人のこゝろののとけからねは",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あすしらぬ物としるノ〓〓〓花ちらぬかきりはみまゝほしはた",
   "kana": "",
   "speaker": "",
   "page": 89,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ちる花をあだなる物といふなれは斯〓のみ社みるへかりけれ",
   "kana": "",
   "speaker": "兼輔卿集",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ひろひ置てみる人しあれは櫻花ちりての後の悔しさもなし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "雪のことちりくる春の櫻花冬は殘れるこゝちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "櫻花しらかにましる老人の宿には春のゆきやたえせし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "わかきたるひとへ衣は山吹の八重の色にもおとらさりけり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "くちなしの色このみといふなはたてゝ井手の山吹盛すく哉",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あふとをこよひ〓〓とたのめすはなか〓〓春の夢もみてまし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "庭たつみ木の本〓とに流すはうたかた花をあはとみましや",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "春雨のふるにつけつゝみの虫のつける枝をは誰か折つる",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "もろともに我をる宿の櫻花あかぬ匂ひを誰にみせまし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "かきりなくなにあふ藤の花なれはそこゐもしらす色の深さに",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "色ふかく匂ひし〓とは藤浪の立もかへらす君とまれとそ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "昨日みし花のかほとてけふみれはねてこそ更に色まさりけれ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "一夜のみねてしかへれは藤の花心とけての色みせんやは",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "いたつらに明はあやなし時鳥なくを待とて君はとゝめん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "つゝむへきほとならなくに時鳥いかゝしてかはふる聲のする",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "時鳥なきのみわたる夏山のしけくも物をしのふ比かな",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "人しれぬ宿にすみせは時鳥うき五月雨はしられさらまし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "時鳥なきまふ里のしけゝれは山へに聲のせぬもことはり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "嬉しくていとゝゆく末わひしきは秋よりさきの風にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "いつしかとまたく心をはきにあけて天の河原をけふや渡らん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "七夕をわたして後は天河浪たかきまて風にふかなん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "戀わたる七夕つめにあらはこそけふしも人にあはんと思はめ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "天河あさせ白浪たとりつゝ渡りはてなは明そしぬへき",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "七夕にわかかすものはまたもなしこよひ計りのあはぬもの也",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "こよひかす七夕つめに身をかへて明は歸らん〓とを社おもへ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "七夕の人に物かすこよひさへいてゝはいたくいそかさらなん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "人しれすおもふ心は秋萩の下葉の色に出ぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "吹風とうとまさらなん秋の夜のえそむつましきしるへ成ける",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "人しれすこゆと忍ひし足引の山下水に影はみえつゝ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "河霧の立しかくせは水底にかけみる人にあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "女郞花は思ひなわひそもろ共に月も過さすむれてとふへし",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "白雲の中にまかひて行雁も聲はかくれぬ物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "いて人の忍ふといひし言の葉は時雨とゝもにちりにけらしも",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "初時雨ふりしそむれは言の葉も色のみまさろ比と社見れ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "はつ時雨ふるにぬれつる我袖のひるまはかりをみるそ侘しき",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "時雨ふるおとはすれとも吳竹のなと世とゝもに色もかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "墨染の衣もよな〓〓へたてつゝおほつかなくや秋を過さん",
   "kana": "",
   "speaker": "兼輔〓集",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "とふ每に名草の濵のなくさまは波のよるひるあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "白浪のよる〓〓〓とになくさまは袖のひるまは我も知なん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "神な月ふたつあるとしの時雨には一本菊そ色こかりける",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "菊の花折てはとらし初霜のおきなかしこそ色まさる比",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "紫の一もときくは萬代をむさしのにこそ賴むへらなれ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "けふほめて雲井にうつす菊の花天つ星とや明日よりはみん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "からにしきあらふとみゆる立田河大和の國のぬさにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "うたゝねのうつゝに物の悲しきは昔のかへをみれは成けり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "むすふをのかけてみたれはむは玉の夜の衣を返すまとしれ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "思ふこといふことかたみ徒にかきてやるをそかたみにはする",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "岩干鳥あやなかるねは何ゆへになかすの濵のなかすにあら南",
   "kana": "",
   "speaker": "兼輔〓集",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "物思ふをなくさの演のいは千鳥なくさむまにそ鳴まさりける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "わすれなん我をうらむな時鳥人を秋にはあはんともせす",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "忘れなは誰かは人を恨へきうきにおくれてしなは我かは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "みくまのゝ浦のはまゆふもゝかさね心はあれとあはぬ君かな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "みくま野の浦の濵ゆふ夕されは我にひとへに思やはすな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "しのゝめの明れは君は忘れなんいつともわかぬ我そかなしき",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "思ふことならすなからに世の中のふれはや雨に我さはりけん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "浮雲に身をしなさねは久かたの月へたつともしられさりけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あひもみて君かきえなはけふ計りちいろの濵の名をも流さん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "人はかる心のくまはきたなくて〓きなきさにいかて行けん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "たかために我は命をなか濵の浦にやとりをしつゝかはこし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "しき妙の枕にちりのゐましかは立なからにそ人はとはまし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "君か爲打拂つゝしき妙の枕のちりにけかれぬるかな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "冬の日はなかむるまにも吳竹のよるそ侘しきなかき思は",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "白雪と今朝はつもれる思かなあはてふるよのほともへなくに",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "冬のよの涙にこほる我袖の心とけすもみえし君かな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "いつとてもはるゝ事なき我身には戀そまさらんかけん物かは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "うき身とて雪ふるまゝに消にしを人にとはれん玉しゐもみん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ふりもせぬ君か雪けの雫ゆへ袂にとけぬ氷しにけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "あふ事をいつしかとのみ思ひつゝくらす心のあやしかりけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "東路のあるかなきかをしらぬまは厭ふにきたる物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "おのの柄も朽やしぬらんあふ事の世〓ふる事の久しと思へは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "心みにひとりぬるよの夢にたにみぬは侘しき物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "語りつといふくちなしの色もなくたてる衣はかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "みまくさのためとおほゆる草莖のむきとや人の今はかるらん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "夕月夜おほつかなきを玉くしけふたみの浦は明てこそみめ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "あらしふく山下とよみなく鹿の妻こふるねに我そ侘しき",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "あふさかの關にわか宿なかりせは別て後はたのまさらまし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "君かゆくこしのしら山しらねとも雪のまに〓〓跡は尋ん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "もろともに惜むわかれもから衣けふはかりそと先そほちける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "思ひやる心しさきに立ぬれはとまる我身はあるかひもなし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "ひとつすに歸りはゐれと濵干鳥しはしもたえは佗しかりける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "風にしもつけつるぬさは道のへの手向にあかぬ神なかれとそ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "白雲のこゝのへにしも立つるは大内山といへはなりけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "足引の山のかけはしふみのほりけふこそ嶺の花はおるらめ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "日の光ちかき朝はいたゝきの霜こそとけて袖ぬらしけれ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "今はとて風まつほとの櫻花人の世よりはひさしかりけり",
   "kana": "",
   "speaker": "兼輔〓集",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "足引の山へに今はすみそめの衣の袖のひる時もなし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "藤衣人の袂とみし物をおのかなみたになかしつる哉",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "立よらんかたもしられすうつせ貝むなしき床の浪のさはきに",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "なき人をわすれかねては忘草おほかる宿にやとりをそする",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "かた時も見てなくさめよ昔よりうれへわするゝ草といふこ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "今はとてをしきなからに藤衣ぬきすてゝけることのわひしき",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "藤衣うきをかきりにはつれつゝ泪の玉をぬくそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "かはりなん世にはいかてかすまふへき思やれともゆかぬ心に",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "秋ふかき色かはるらん菊の花君かよはひの千世しとまらは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "おらかはる萩の下葉のしたにのみ秋うき物と我なきそへん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "人の世のおもひにかなふ物ならは我身は君におくれさらまし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "いたつらにけふやくれなんあたらしき年の始は昔なからに",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "なく泪ふりにし年の衣手はあらたまれともかはらさりけり",
   "kana": "",
   "speaker": "兼輔卿集",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "都にはみるへき君がなき物を常に思ひて春やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "はかなくて世〓ふるよりは山科の宮の草木とならまし物を",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "山科の宮の草木と君ならは我も雫にぬるはかりなり",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "櫻ちる春のくれには成にけりあやめもしらぬなけきせしまに",
   "kana": "",
   "speaker": "おとゝ",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "春ふかくちりかふ花をかすにてもとりあへぬ物は泪成けり",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "ひとへたにきるはわひしき藤衣かさなる秋を思やらなん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "足引の山へにをれは白雲の立ゐたゆたひ物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "朝夕の身にはそへともあら玉のとしつもりゆく我そかなしき",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "年たけてあひつることを數ふれは我もおきなに成そしにける",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "とし〓とに鳴つる鴈と聞しまに我はひたすら老そしにける",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "人のおやの心はやみにあらねとも子を思ふ道にまとひぬる哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "子の爲に殘す命をへてしかなおひてさきたつくひなかるへく",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "我わひんかしらのしろくなるまてに年月ふともあはす成なは",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "かすみたつみねやいつくと尋みん花のとをめをまきらはす哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "並〓の人なみならは住の江はまつともいふに出ていなましを",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "陸奥のしら川こえてあひ〓〓つしさる〓〓もゆけとはろけき",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "わすれにしさきをうしとは思へとも心は雲のうちしのふかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "今はいぬゐのへの松のおひぬらん年月ふともさかりとけなん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "しきたへの枕に涙せかれつゝ夢とたにみぬころにも有かな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "憎かりし人のあたりはものうしとらはとらなん玉のをにして",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "秋はきの枝にかゝれる白露をあやしく玉と我おもふ哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "ふたりねし床にて深く契りてきのとかに我をうちたのめとて",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "はしたかのとかへる山のしひのえは常盤にかれぬ中を賴まん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "夕されはあひみるへきを春の日のとくくれぬ社侘しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "風さむみ衣うつなるつちのえのおれぬはかりに音のするかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "門田かりせきのふかりを思ひしをひつちのとくもおひにける哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "梅の花いつれは□にくからすかのえたおりて家つとにせん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "さをしかのともまよはせる聲すん妻や戀しき秋の山へに",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "淀河やすきてあなたにある水のえこそまたみね駒の立とも",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "ちはやふる神の社のいふはかり水のとあ〓て祈るめる哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "別れてもなを忘られすうちしのひとくめくりこよ空のうき雲",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "いてたては後めたなくある人よめくりに凡てみるよしもかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "よのつねにきくたにあるを時鳥なき人こふるおり〓〓の聲",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
